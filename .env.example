# Copy this file to `.env` and fill in your Pingen STAGING credentials.
# The integration suite (`./integration`, build tag `integration`, run with
# `make test-integration`) reads these values and talks to the REAL Pingen
# staging API — it creates, sends, cancels and deletes real staging resources.
# The suite is skipped automatically when the credentials below are missing.
# See: https://api.pingen.com/documentation#section/Authentication
#
# `.env` is git-ignored – never commit real credentials.

# OAuth client credentials (client_credentials grant) for the STAGING
# environment. Without both of these the integration suite skips.
PINGEN2_CLIENT_ID=your-staging-client-id
PINGEN2_CLIENT_SECRET=your-staging-client-secret

# Organisation to run the tests against. Optional: when your credentials have
# access to several organisations, set this to pick a specific one. When left
# empty, the tests fall back to the first organisation returned by the API.
PINGEN2_ORGANIZATION_ID=

# Name of the organisation above. Optional: when set, the tests assert the
# fetched organisation's name matches this value; when empty the name is not
# checked.
PINGEN2_ORGANIZATION_NAME=

# Run the integration tests against staging (true) or production (false).
# Defaults to true when unset — keep it that way, the suite creates and deletes
# real resources and should never hit production.
PINGEN2_USE_STAGING=true
